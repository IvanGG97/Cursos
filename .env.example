# Copiar a .env.local y completar con los datos del proyecto de Supabase
# (Supabase → Project Settings → API Keys / Data API).
# Sin estas dos variables la app corre en "modo local" (solo en desarrollo): sin login y con acceso de admin.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# URL pública del sitio (para los links de login). En Vercel: https://tu-dominio.com
# Si se deja vacía, se toma del request.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# "on" para mostrar el botón "Continuar con Google" (requiere configurar el proveedor en Supabase → Authentication).
NEXT_PUBLIC_AUTH_GOOGLE=on

# ID de cliente OAuth de Google (Google Cloud → Credenciales). Es público.
# Con él, el login usa el botón oficial de Google en este sitio y Google muestra NUESTRO dominio
# (no el de Supabase). Debe estar también en Supabase → Providers → Google → Client IDs.
# En Google Cloud, el cliente necesita este sitio en "Orígenes autorizados de JavaScript".
NEXT_PUBLIC_GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxx.apps.googleusercontent.com
